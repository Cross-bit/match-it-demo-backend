{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "User account service API",
    "description": "REST API for account management, credentials and profile preferences."
  },
  "servers": [
    {
      "url": "/",
      "description": "Service root URL."
    }
  ],
  "tags": [
    {
      "name": "Credentials",
      "description": "Registration, login and account verification."
    },
    {
      "name": "Account",
      "description": "Authenticated account actions."
    },
    {
      "name": "Users",
      "description": "Public profiles lookup for authenticated users."
    },
    {
      "name": "Preferences",
      "description": "User profile picture management."
    },
    {
      "name": "Tokens",
      "description": "Access token refresh."
    }
  ],
  "paths": {
    "/api/v1/credentials/create": {
      "post": {
        "tags": ["Credentials"],
        "summary": "Create credentials account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created."
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/credentials/login": {
      "post": {
        "tags": ["Credentials"],
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccessResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "409": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/credentials/verify/{verificationToken}": {
      "get": {
        "tags": ["Credentials"],
        "summary": "Verify new account by email token",
        "parameters": [
          {
            "in": "path",
            "name": "verificationToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML verification page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal verification error.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/credentials/logoutAll/{adminToken}": {
      "get": {
        "tags": ["Credentials"],
        "summary": "Logout all users (admin key endpoint)",
        "parameters": [
          {
            "in": "path",
            "name": "adminToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bulk logout result."
          },
          "403": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/refresh": {
      "post": {
        "tags": ["Tokens"],
        "summary": "Refresh access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/account/logout": {
      "delete": {
        "tags": ["Account"],
        "summary": "Logout current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logout result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleResultResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/account/delete": {
      "delete": {
        "tags": ["Account"],
        "summary": "Delete current user account",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Delete account result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimpleResultResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/users/batch": {
      "get": {
        "tags": ["Users"],
        "summary": "Get users profiles batch",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "uuids",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "style": "form",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "Batch of user public profiles.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profiles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserProfileDto"
                      }
                    }
                  },
                  "required": ["profiles"]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/users/{userUUID}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get single user profile",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "path",
            "name": "userUUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User public profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileDto"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/preferences/profilePic/upload": {
      "post": {
        "tags": ["Preferences"],
        "summary": "Upload user profile picture",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "profilePic": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["profilePic"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded profile picture info.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilePictureUploadResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/preferences/profilePic": {
      "get": {
        "tags": ["Preferences"],
        "summary": "Get current user profile picture URL",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Profile picture URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfilePictureResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "500": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Standard API error payload.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseDTO"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "name": { "type": "string" }
        },
        "required": ["email", "password", "name"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "fcmToken": { "type": "string" }
        },
        "required": ["email", "password", "fcmToken"]
      },
      "LoginSuccessResponse": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "result": { "type": "string" },
          "uuid": { "type": "string", "format": "uuid" },
          "accessRights": { "type": "string" },
          "authenticationMethod": { "type": "string" },
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "isRefresh": { "type": "boolean" },
          "preferences": {
            "type": "object",
            "properties": {
              "profilePictureUrl": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "required": [
          "result",
          "uuid",
          "accessRights",
          "authenticationMethod",
          "accessToken",
          "refreshToken",
          "isRefresh"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        },
        "required": ["refreshToken"]
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "updatedToken": {
            "type": "string"
          }
        },
        "required": ["updatedToken"]
      },
      "SimpleResultResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": ["OK", "NOK"]
          }
        },
        "required": ["result"]
      },
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "uuid": { "type": "string", "format": "uuid" },
          "name": { "type": ["string", "null"] },
          "avatarUrl": { "type": ["string", "null"] }
        },
        "required": ["uuid", "name", "avatarUrl"]
      },
      "ProfilePictureUploadResponse": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "creationTime": { "type": "string" }
        },
        "required": ["url", "creationTime"]
      },
      "ProfilePictureResponse": {
        "type": "object",
        "properties": {
          "url": { "type": "string" }
        },
        "required": ["url"]
      },
      "ErrorResponseDTO": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "message": { "type": "string" },
          "status": { "type": "integer" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": ["name", "message", "status"]
      }
    }
  }
}
