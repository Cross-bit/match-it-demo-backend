c-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/117051354224753765930/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2tweE0xcG1WRVpzYW5aMWRISjVTbkZQY25rNVduYxAB","publishTime":"2025-08-31T06:12:29.402546361Z","rating":5,"text":"Nice variety of savory and sweet dishes to choose from in a buffet style setting. Pay by weight at a very reasonable price. My partner and I ate dinner and left quite full for just under $24 USD. The vibes were pleasant and the setting was serene, and just what we needed after a long day of travel. Come 30 minutes before closing and get a discount on prices too!"},{"authorAttribution":{"displayName":"Hana","photoUri":"https://lh3.googleusercontent.com/a/ACg8ocLT8q3ydEODxRFySsyTimwIJ6kPVr77WMCr9930iMjtK96PCqPl=s128-c0x00000000-cc-rp-mo","uri":"https://www.google.com/maps/contrib/108930247671541565827/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xoak5GcDBUMUo2Ynkxd1JIUm5VemxNUkdkbmJFRRAB","publishTime":"2025-07-10T10:15:18.820991563Z","rating":5,"text":"Oasis for vegans! Food was tasty with many salad options, it is sold by weight, it was all fresh and good quality.\n\nRestaurant is quiet and comfortable even half full. A gem, considering Czech restaurants are not vegan aware. It was exciting to have coffee and cake options in front as well."},{"authorAttribution":{"displayName":"Julia","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjXLm9hID6akvgwveLtO3lcCRwu7mVTz3ARIuBdWF8UMyGDknxXyaw=s128-c0x00000000-cc-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/109391991894255255503/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT21STmNuQTRjR0k1UVZjd1gyUnZNWEJ5V0V3NVNVRRAB","publishTime":"2025-06-27T21:21:09.066993855Z","rating":5,"text":"A wonderful place with a very cozy atmosphere and a diverse selection of vegan food offered as a self-service hot and cold buffet. The interior is beautifully decorated and comfortable, with working air conditioning that keeps the space pleasantly cool, especially important on hot days. You can help yourself to complimentary water infused with natural fruit flavors. The staff is very friendly, and there's also a separate café counter with delicious cakes and desserts."},{"authorAttribution":{"displayName":"Kasia Stokeley","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjWoSrPPTcxCaUCnW9iiJqSuWX3fPe36-dIDyfgzO94KSB3al_M=s128-c0x00000000-cc-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/104759198861811949620/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xSRk5WcDRYM2RoT1RKV1psVldaVmxYU1dGb1lrRRAB","publishTime":"2025-09-05T15:10:25.906447694Z","rating":5,"text":"Oh my! Little gem of vegan world! Great selection of dishes for great price! Very tasty and if you have still space in your belly- try their cakes! Awsome! 😍"}],"placeUrl":"https://maps.google.com/?cid=17422315048803248144&g_mp=Cidnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLlNlYXJjaFRleHQQAhgEIAA","priceLevel":3,"rating":4.5,"restaurantId":619,"servesVegetarian":true,"takeout":true,"title":"Loving Bistro - Černá Labuť","type":["vegan_restaurant","vegetarian_restaurant","fast_food_restaurant","buffet_restaurant","restaurant","point_of_interest","food","establishment"]},{"cardId":1666,"delivery":false,"goodForGroups":false,"location":{"lat":50.0906698,"long":14.4319142},"locationAddress":"13, Zlatnická 1120, Nové Město, 110 00 Praha-Praha 1, Czechia","openingHours":null,"outdoorSeating":false,"placePhotos":[{"authorAttributions":{"displayName":"Filip Sausa","photoUri":"https://lh3.googleusercontent.com/a/ACg8ocIJMXo52ugZ2r48lprD_4PV0a8NEnWZq4t1o_YpZPkF_ym4RA=s100-p-k-no-mo","uri":"https://maps.google.com/maps/contrib/111336324050722725174"},"name":"places/ChIJnRZ7CMCUC0cReQ9nkOwPFrs/photos/AZLasHrgLPW-tURUKkWyqO_h49tj8P56mOwqlSOXbjIu3_MzGL119lpr38dx9VbWeMeJlfWPTsVsCl_GFzWXfeV0kKDFVJvnOpbB0g-H5dLcdMl9qKH7SY1h3m02Nuw-LA0MzuC9P2U1Q5vvci7pljplbXs