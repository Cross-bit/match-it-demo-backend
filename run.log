AnSEcLWdeK-a8C_XuaAwTrs1uAT_pdlgohiMvh0vAUkBip9KzLMWE1vxa22qWCD4qM_FBuv_nR01fWEFNL8DA6JvJFP_A","url":"http://192.168.0.245:9070/static/places_photos/b5472ed22cd3f627f7beb2eefe3a68ab8d5045074af36e609f2cd99364b070cf.jpg"},{"authorAttributions":{"displayName":"Any Jindrová","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjWXiNPRs4OdjJDW6G4DdGhNO-JdB8UB5noLMeBs-Q06bd3o26fY=s100-p-k-no-mo","uri":"https://maps.google.com/maps/contrib/112655876825868118581"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/photos/AZLasHoq6CXPoPenSkMVSQm3zPgRd9b36vBIS9f2viAtA1syWGUANjVgtxqr27oDikdUNoSl0yQ_D3DP2piu7qxw4QbICh13OOgqn4F1Oo5Nk3uKIGRazIcxnmC0MVbZGZfDITqs87S2inp4_vqCb2DQ-brqQtaxSBL5pvAyTrwI1Z57blo07DKpub-d5h9HlsT3oD9uLd4M9Pb1hGeth4TTcT6AA38__eAJJCkqHZ-RCpf29FEOg3APArVe3JDQZnCl0kjgjsN17fWgUqBi-YYfpWLLxpIs69v9yE0vTKRNHHgkRuqAg296SxnjHuMD98PCLOTDgo-zUdeQhDW0JxhdRuTd2fpxMxMZWCFVAZkOn17nZW0hJzq7AkzYamRICiAxsxot199CCWTu4QxXfpoYk-yROWasmIAILCfuvIUIPjv58Cc952kv46ny8LXoneGZ","url":"http://192.168.0.245:9070/static/places_photos/331e002b41f4fb07974a1ff11091a69d0c6af5f2534860ecc8d9ae7617e921fc.jpg"}],"placeReviews":[{"authorAttribution":{"displayName":"Lorna Saffer","photoUri":"https://lh3.googleusercontent.com/a/ACg8ocLUblYTArTp_E8FGZzNt7dhOj2Mh-McaL0jSchHqFQQxlTBXg=s128-c0x00000000-cc-rp-mo-ba5","uri":"https://www.google.com/maps/contrib/105209741164462018551/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xKd2J6UlpNM2d0YTBwTFVGbzVaWEZaYkZNMWFIYxAB","publishTime":"2025-11-24T19:55:51.463326085Z","rating":5,"text":"Amazing all vegan buffet! You fill your plate or take out container and then pay by weight. Very reasonably priced! There is a great selection of hot cooked foods, cold foods and salad. They also have a range of cakes. Food is excellent, there is plenty of seating and the space is bright and clean. Would definitely recommend eating here!"},{"authorAttribution":{"displayName":"Jeremy Munn","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjXbL6Im03agdOHCgcpv9EPzWzZQXjY0TZsmHpYSGDSfA86zcLZ_=s128-c0x00000000-cc-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/117051354224753765930/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2tweE0xcG1WRVpzYW5aMWRISjVTbkZQY25rNVduYxAB","publishTime":"2025-08-31T06:12:29.402546361Z","rating":5,"text":"Nice variety of savory and sweet dishes to choose from in a buffet style setting. Pay by weight at a very reasonable price. My partner and I ate dinner and left quite full for just under $24 USD. The vibes were pleasant and the setting was serene, and just what we needed after a long day of travel. Come 30 minutes before closing and get a discount on prices too!"},{"authorAttribution":{"displayName":"Hana","photoUri":"https://lh3.googleusercontent.com/a/ACg8ocLT8q3ydEODxRFySsyTimwIJ6kPVr77WMCr9930iMjtK96PCqPl=s128-c0x00000000-cc-rp-mo","uri":"https://www.google.com/maps/contrib/108930247671541565827/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xoak5GcDBUMUo2Ynkxd1JIUm5VemxNUkdkbmJFRRAB","publishTime":"2025-07-10T10:15:18.820991563Z","rating":5,"text":"Oasis for vegans! Food was tasty with many salad options, it is sold by weight, it was all fresh and good quality.\n\nRestaurant is quiet and comfortable even half full. A gem, considering Czech restaurants are not vegan aware. It was exciting to have coffee and cake options in front as well."},{"authorAttribution":{"displayName":"Julia","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjXLm9hID6akvgwveLtO3lcCRwu7mVTz3ARIuBdWF8UMyGDknxXyaw=s128-c0x00000000-cc-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/109391991894255255503/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT21STmNuQTRjR0k1UVZjd1gyUnZNWEJ5V0V3NVNVRRAB","publishTime":"2025-06-27T21:21:09.066993855Z","rating":5,"text":"A wonderful place with a very cozy atmosphere and a diverse selection of vegan food offered as a self-service hot and cold buffet. The interior is beautifully decorated and comfortable, with working air conditioning that keeps the space pleasantly cool, especially important on hot days. You can help yourself to complimentary water infused with natural fruit flavors. The staff is very friendly, and there's also a separate café counter with delicious cakes and desserts."},{"authorAttribution":{"displayName":"Kasia Stokeley","photoUri":"https://lh3.googleusercontent.com/a-/ALV-UjWoSrPPTcxCaUCnW9iiJqSuWX3fPe36-dIDyfgzO94KSB3al_M=s128-c0x00000000-cc-rp-mo-ba3","uri":"https://www.google.com/maps/contrib/104759198861811949620/reviews"},"name":"places/ChIJu_j02b-UC0cRECjcwDp_yPE/reviews/Ci9DQUlRQUNvZENodHljRjlvT2xSRk5WcDRYM2RoT1RKV1psVldaVmxYU1dGb1lrRRAB","publishTime":"2025-09-05T15:10:25.906447694Z","rating":5,"text":"Oh my! Little gem of vegan world! Great selection of dishes for great price! Very tasty and if you have still space in your belly- try their cakes! Awsome! 😍"}],"placeUrl":"https://maps.google.com/?cid=17422315048803248144&g_mp=Cidnb29nbGUubWFwcy5wbGFjZXMudjEuUGxhY2VzLlNlYXJjaFRleHQQAhgEIAA","priceLevel":3,"rating":4.5,"restaurantId":619,"servesVegetarian":true,"takeout":true,"title":"Loving Bistro - Černá Labuť","type":["vegan_restaurant","vegetarian_restaurant","fast_food_restaurant","buffet_restaurant","restaurant","point_of_interest","food","establishment"]}},{"itemId":1666,"rank":2,"run":0,"score":1.4246345795776056,"cardData":{"cardId":1666,"delivery":false,"goodForGroups":false,"location":{"lat":50.0906698,"long":14.4319142},"locationAddress":"13, Zlatnická 1120, Nové Město, 110 00 Praha-Praha 1, Czechia","openingHours":null,"outdoorSeating":false,"placePhotos":[{"authorAttributions":{"displayName":"Filip Sausa","photoUri":"https://lh3.googleusercontent.com/a/ACg8ocIJMXo52ugZ2r48lprD_4PV0a8NEnWZq4t1o_YpZPkF_ym4RA=s100-p-k-no-mo","uri":"https://maps.google.com/maps/contrib/111336324050722725174"},"name":"places/ChIJnRZ7CMCUC0cReQ9nkOwPFrs/photos/AZLasHrgLPW-t